# Copy to .env and edit
PORT=3000
# Public URL of the site (used inside the QR code). Must be https in production.
BASE_URL=http://localhost:3000
NODE_ENV=development
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# Admin access (emails allowed to sign in to /admin). Super admin can grant more from the console.
SUPER_ADMIN_EMAIL=admin@xerago.com
ADMIN_EMAILS=moderator@xerago.com
# Employee rules
MAX_POSTS=3
AUTO_PUBLISH=true
# true = only employees listed in data/employees.json can sign in
EMPLOYEE_ALLOWLIST=false
# Email delivery for admin login codes (leave SMTP_HOST empty to print codes in the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Xerago Diwali <no-reply@xerago.com>"
# Development only: return the admin code in the API response. NEVER true in production.
DEV_SHOW_CODE=false
# Optional: change the admin page path, e.g. /ops-9f3k
ADMIN_PATH=/admin
# Optional: where data is stored
DATA_DIR=./data
